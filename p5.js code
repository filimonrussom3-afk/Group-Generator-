 let nameInput, groupInput, outputDiv;

function setup() {
  noCanvas();

  let container = createDiv();
  container.style("max-width", "600px");
  container.style("margin", "40px auto");
  container.style("padding", "20px");
  container.style("border", "1px solid #ccc");
  container.style("border-radius", "8px");
  container.style("height", "auto");     

  createElement("h2", "Group Generator").parent(container);

  nameInput = createElement("textarea");
  nameInput.parent(container);
  nameInput.attribute("placeholder", "Enter names(one per line)");
  nameInput.style("width", "100%");
  nameInput.style("height", "190px");

  createElement("br").parent(container);

  groupInput = createInput("4");
  groupInput.parent(container);

  createElement("br").parent(container);

  let btn = createButton(" Generate ");
  btn.parent(container);
  btn.mousePressed(generateGroups);

  outputDiv = createDiv();
  outputDiv.parent(container);
  outputDiv.style("margin-top", "40px");
}

function generateGroups() {
  let names = nameInput.value().split("\n").filter(n => n.trim() !== "");
  let size = int(groupInput.value());

  if (names.length === 0) {
    outputDiv.html("Please enter some names.");
    return;
  }

  if (size <= 0) {
    outputDiv.html("Invalid group size");
    return;
  }

  shuffle(names, true);

  let groups = [];
  for (let i = 0; i < names.length; i += size) {
    groups.push(names.slice(i, i + size));
  }

  displayGroups(groups);
}

function displayGroups(groups) {
  let html = "";

  for (let i = 0; i < groups.length; i++) {
    html += `<div style="margin:10px; padding:10px; border:1px solid #ddd;">
      <b>Group ${i + 1}</b><br>
      ${groups[i].join("<br>")}
    </div>`;
  }

  outputDiv.html(html);
}
